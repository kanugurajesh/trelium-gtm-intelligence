# Generated artifacts use LF so diffs are stable across platforms.
* text=auto eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.csv text eol=lf
*.pdf binary
# Evidence snapshots are hashed bytes (E1 in docs/EVIDENCE_MODEL.md). Git must never
# normalise their line endings in either direction, or a clean clone fails verification.
evidence/raw/** -text
